# Copy to .env and fill in, then: set -a; source .env; set +a; ./register.sh

# Your Agent37 secret key. Mint one at https://www.agent37.com/dashboard/cloud.
# Keep it server-side; never ship it to a browser.
AGENT37_API_KEY=sk_live_...

# Choose exactly ONE image source:

# A public image. Pin a tag (use the :<sha> the Action prints or a release tag).
# IMAGE_REF=ghcr.io/your-username/my-agent:<sha>

# A local `docker save` archive (plain tar or tar.gz). Use this for a private or
# unpublished image; Agent37 does not accept private-registry credentials.
# IMAGE_ARCHIVE=./my-agent.tar

# Optional overrides:
# TEMPLATE_NAME=my-custom-agent
# AGENT37_API_BASE=https://api.agent37.com
