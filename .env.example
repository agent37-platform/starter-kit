# Get it from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=sk_live_replace_me

# Backend: supabase (default) or neon. `npm run setup:neon` sets this to neon for you.
# Inlined at build time — restart `npm run dev` / redeploy after changing it.
NEXT_PUBLIC_BACKEND=supabase

# ── Supabase backend ──────────────────────────────────────────────────────────────────────────────

# Get it from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_replace_me

# Filled in by `npm run setup` — leave blank for a fresh free project, or paste an
# existing project's values (Project Settings -> API) to use that one instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Also filled in by `npm run setup`. Server-only (no NEXT_PUBLIC_ prefix) — never commit it
# or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Neon backend ──────────────────────────────────────────────────────────────────────────────────

# Filled in by `npm run setup:neon` — leave blank for a new claimable project, or paste an existing
# project's values. All server-only.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Setup-only, like SUPABASE_ACCESS_TOKEN — never deploy. Remove after claiming the project.
NEON_CLAIM_ASSERTION=
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# Production only (local dev uses the browser's origin). Set your deployed URL and re-run setup so
# it's allow-listed for auth redirects (Neon: only after claiming, with NEON_API_KEY set).
# NEXT_PUBLIC_SITE_URL=https://your-app.com
